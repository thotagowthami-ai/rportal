# ── Frontend Dev Dockerfile ─────────────────────────────────────────────────
FROM node:20-alpine

WORKDIR /app

# Install dependencies first (layer caching)
COPY package.json package-lock.json* ./
RUN npm ci

# Copy source (overridden by volume mount in dev)
COPY . .

# Expose Next.js dev port
EXPOSE 3000

# Run dev server with hot-reload
CMD ["npm", "run", "dev"]
