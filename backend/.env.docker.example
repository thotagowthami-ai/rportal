# ─────────────────────────────────────────────────────────────────────────────
# .env.docker.example — Local Dev DB credentials template
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file:  cp .env.docker.example .env.docker
# 2. Fill in real values in .env.docker  (it is git-ignored)
# 3. Start services:
#    docker compose -f docker-compose.dev.yml --env-file .env.docker up -d
# ─────────────────────────────────────────────────────────────────────────────

POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_strong_password
POSTGRES_DB=your_db_name
